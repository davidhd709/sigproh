# Copiar en el VPS como .env.production y reemplazar los valores marcados.
# Para secretos seguros: openssl rand -hex 32 (la contraseña de PostgreSQL queda en hexadecimal).
POSTGRES_DB=sigproh
POSTGRES_USER=sigproh
POSTGRES_PASSWORD=REEMPLAZAR_POR_64_CARACTERES_HEXADECIMALES
JWT_ACCESS_SECRET=REEMPLAZAR_POR_UN_SECRETO_HEXADECIMAL_ALEATORIO
JWT_ACCESS_EXPIRES_IN=15m

# El proxy del host debe apuntar a http://127.0.0.1:8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
