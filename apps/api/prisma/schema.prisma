generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  DIRECTOR_OPERATIVO
  GERENTE
  AUXILIAR_GERENCIA
  COORDINADOR_OPERATIVO
}

enum IssueScope {
  PROPIEDAD
  INTERNA
}

enum ReportScope {
  PROPIEDAD
  INTERNA
  CONSOLIDADO
}

enum ReportStatus {
  BORRADOR
  EN_REVISION
  DEVUELTO
  APROBADO
}


enum IssuePriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum IssueStatus {
  REGISTRADA
  EN_REVISION
  ASIGNADA
  EN_ATENCION
  PENDIENTE_CIERRE
  CERRADA
  DESCARTADA
}

enum ActivityStatus {
  PENDIENTE
  EN_CURSO
  BLOQUEADA
  COMPLETADA
  CANCELADA
}

enum EvidenceStage {
  INICIAL
  EJECUCION
  FINAL
  SOPORTE
}

enum IssueEventType {
  CREACION
  SUGERENCIA_RESPONSABLE
  CONFIRMACION_ASIGNACION
  REASIGNACION
  CAMBIO_PRIORIDAD
  MEDIDA_URGENTE
  ACTIVIDAD_CREADA
  ACTIVIDAD_ASIGNADA
  ACTIVIDAD_REASIGNADA
  ACTIVIDAD_ESTADO
  COMENTARIO_AGREGADO
  EVIDENCIA_ADJUNTADA
  DEVOLUCION
  SOLICITUD_CIERRE
  CIERRE_DEFINITIVO
  REAPERTURA
  DESCARTE
}


model Organization {
  id            String         @id @default(uuid())
  name          String
  users         User[]
  properties    Property[]
  internalAreas InternalArea[]
  categories    Category[]
  issues        Issue[]
  issueSequences IssueSequence[]
  notifications Notification[]
  reports       Report[]
  reportSequences ReportSequence[]
  institutionalTemplates InstitutionalTemplate[]
  propertyReportConfigs PropertyReportConfig[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("organizations")
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  role           Role      @default(COORDINADOR_OPERATIVO)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  refreshSessions     RefreshSession[]
  propertyAssignments PropertyAssignment[]
  areaAssignments     AreaAssignment[]
  createdIssues       Issue[]              @relation("IssueCreatedBy")
  suggestedIssues     Issue[]              @relation("IssueSuggestedUser")
  assignedIssues      Issue[]              @relation("IssueAssignedUser")
  assignmentsGiven    IssueAssignment[]    @relation("AssignedByUser")
  assignmentsReceived IssueAssignment[]    @relation("AssignedToUser")
  issueEvents         IssueEvent[]
  notifications       Notification[]
  activitiesAssigned  IssueActivity[]      @relation("ActivityAssignedUser")
  activitiesCreated   IssueActivity[]      @relation("ActivityCreatedBy")
  issueComments       IssueComment[]
  attachmentsUploaded IssueAttachment[]    @relation("AttachmentUploadedBy")
  reportsCreated         Report[]                @relation("ReportCreatedBy")
  reportsApproved        Report[]                @relation("ReportApprovedBy")
  templatesCreated       InstitutionalTemplate[] @relation("TemplateCreatedBy")
  propertyConfigsUpdated PropertyReportConfig[]  @relation("PropertyConfigUpdatedBy")
  reportVersionsCreated  ReportVersion[]         @relation("ReportVersionCreatedBy")
  reportVersionsApproved ReportVersion[]         @relation("ReportVersionApprovedBy")
  reportReviews          ReportReview[]          @relation("ReportReviewer")
  reportDistributions    ReportDistribution[]    @relation("ReportDistributedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([role])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model Property {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String?
  nit            String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  zones        PropertyZone[]
  assignments  PropertyAssignment[]
  issues       Issue[]
  reports      Report[]
  reportConfig PropertyReportConfig?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("properties")
}

model PropertyZone {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  issues   Issue[]

  @@index([propertyId])
  @@map("property_zones")
}

model PropertyAssignment {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  isLead     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([propertyId, userId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_assignments")
}

model InternalArea {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  AreaAssignment[]
  issues       Issue[]
  reports      Report[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("internal_areas")
}

model AreaAssignment {
  id             String   @id @default(uuid())
  internalAreaId String
  userId         String
  isLead         Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  internalArea InternalArea @relation(fields: [internalAreaId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([internalAreaId, userId])
  @@index([userId])
  @@index([internalAreaId])
  @@map("area_assignments")
}

model Category {
  id             String     @id @default(uuid())
  organizationId String
  scope          IssueScope
  name           String
  description    String?
  requiresEvidence Boolean    @default(true)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  issues       Issue[]

  @@unique([organizationId, scope, name])
  @@index([organizationId])
  @@map("categories")
}

model Issue {
  id              String        @id @default(uuid())
  organizationId  String
  code            String        // Ej: NOV-2026-0001
  scope           IssueScope
  title           String
  description     String
  priority        IssuePriority @default(MEDIA)
  initialPriority IssuePriority @default(MEDIA)
  status          IssueStatus   @default(REGISTRADA)

  // Pertenencia exclusiva a Propiedad o Área Interna
  propertyId     String?
  propertyZoneId String?
  internalAreaId String?

  categoryId  String
  createdById String

  // Asignación mixta (sugerida vs confirmada)
  suggestedUserId String?
  assignedUserId  String?

  // Medidas urgentes para casos críticos
  urgentMeasures String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property?         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  propertyZone   PropertyZone?     @relation(fields: [propertyZoneId], references: [id], onDelete: Restrict)
  internalArea   InternalArea?     @relation(fields: [internalAreaId], references: [id], onDelete: Restrict)
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("IssueCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  suggestedUser  User?             @relation("IssueSuggestedUser", fields: [suggestedUserId], references: [id], onDelete: Restrict)
  assignedUser   User?             @relation("IssueAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  assignments    IssueAssignment[]
  events         IssueEvent[]
  notifications  Notification[]
  activities     IssueActivity[]
  comments       IssueComment[]
  attachments    IssueAttachment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([scope])
  @@index([propertyId])
  @@index([internalAreaId])
  @@index([assignedUserId])
  @@index([status])
  @@index([priority])
  @@map("issues")
}

model IssueAssignment {
  id           String   @id @default(uuid())
  issueId      String
  userId       String
  assignedById String
  reason       String?
  isCurrent    Boolean  @default(true)
  createdAt    DateTime @default(now())

  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  user       User  @relation("AssignedToUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User  @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([userId])
  @@map("issue_assignments")
}

model IssueEvent {
  id        String         @id @default(uuid())
  issueId   String
  userId    String
  eventType IssueEventType
  summary   String
  details   Json?
  createdAt DateTime       @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([createdAt])
  @@map("issue_events")
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  recipientId    String
  issueId        String?
  title          String
  message        String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  issue        Issue?       @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

model IssueSequence {
  id             String       @id @default(uuid())
  organizationId String
  year           Int
  lastValue      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("issue_sequences")
}

model IssueActivity {
  id             String         @id @default(uuid())
  issueId        String
  title          String
  description    String
  status         ActivityStatus @default(PENDIENTE)
  statusReason   String?        // Obligatorio para estados BLOQUEADA y CANCELADA (RF-019 / RN-069 / RN-070)
  assignedUserId String?
  createdById    String
  dueDate        DateTime?
  completedAt    DateTime?
  version        Int            @default(1) // Control de concurrencia optimista (409 Conflict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  issue        Issue             @relation(fields: [issueId], references: [id], onDelete: Restrict)
  assignedUser User?             @relation("ActivityAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  comments     IssueComment[]
  attachments  IssueAttachment[]

  @@index([issueId])
  @@index([assignedUserId])
  @@index([status])
  @@map("issue_activities")
}

model IssueComment {
  id         String   @id @default(uuid())
  issueId    String
  activityId String?
  userId     String
  content    String
  mentions   String[] @default([]) // Array de IDs de usuarios mencionados autorizados
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  issue    Issue          @relation(fields: [issueId], references: [id], onDelete: Restrict)
  activity IssueActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([activityId])
  @@index([userId])
  @@map("issue_comments")
}

model IssueAttachment {
  id           String        @id @default(uuid())
  issueId      String
  activityId   String?
  uploadedById String
  stage        EvidenceStage @default(SOPORTE)
  fileName     String        // Nombre original del archivo sanitizado
  fileSize     Int           // Tamaño en bytes
  mimeType     String        // Tipo MIME validado
  sha256       String        // Hash SHA-256 para integridad
  storageKey   String        @unique // Identificador privado de almacenamiento (la ruta física nunca se expone al cliente)
  createdAt    DateTime      @default(now())

  issue      Issue          @relation(fields: [issueId], references: [id], onDelete: Restrict)
  activity   IssueActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  uploadedBy User           @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([activityId])
  @@index([uploadedById])
  @@index([stage])
  @@map("issue_attachments")
}

model Report {
  id             String       @id @default(uuid())
  organizationId String
  code           String       // Ej: INF-2026-0001
  scope          ReportScope
  title          String

  propertyId     String?
  internalAreaId String?

  periodStart    DateTime
  periodEnd      DateTime
  cutoffDate     DateTime

  status         ReportStatus @default(BORRADOR)
  version        Int          @default(1)

  // Textos editables por el autor (RF-033 / CP-19)
  introduction    String?
  observations    String?
  recommendations String?
  finalComments   String?

  // IDs de evidencias seleccionadas para el informe (RF-034)
  selectedAttachmentIds String[] @default([])

  // Configuración de visibilidad de secciones (opcionales)
  showIntroduction    Boolean @default(true)
  showKpis            Boolean @default(true)
  showIssuesList      Boolean @default(true)
  showActivities      Boolean @default(true)
  showEvidences       Boolean @default(true)
  showPendingIssues   Boolean @default(true)
  showObservations    Boolean @default(true)
  showRecommendations Boolean @default(true)
  showFinalComments   Boolean @default(true)

  // Datos operacionales cacheados/congelados (RF-032 / RF-035)
  operationalData     Json?

  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  approvalNotes  String?

  templateVersion       Int                  @default(1)
  propertyConfigVersion Int?
  pdfStorageKey         String?
  pdfSha256             String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  internalArea   InternalArea? @relation(fields: [internalAreaId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?         @relation("ReportApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  versions       ReportVersion[]
  reviews        ReportReview[]
  distributions  ReportDistribution[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([scope])
  @@index([propertyId])
  @@index([internalAreaId])
  @@index([createdById])
  @@index([status])
  @@map("reports")
}

model ReportSequence {
  id             String       @id @default(uuid())
  organizationId String
  year           Int
  lastValue      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("report_sequences")
}

model InstitutionalTemplate {
  id                      String   @id @default(uuid())
  organizationId          String
  name                    String   @default("Plantilla Institucional Estándar")
  version                 Int      @default(1)
  isPublished             Boolean  @default(true)
  headerTitle             String   @default("EG S.A.S. — PLATAFORMA SIGPROH")
  headerSubtitle          String   @default("GESTIÓN Y CONTROL DE NOVEDADES OPERATIVAS")
  primaryColor            String   @default("#1E3A8A")
  secondaryColor          String   @default("#2563EB")
  footerText              String   @default("Documento oficial generado por la Plataforma SIGPROH — EG S.A.S.")
  mandatorySections       String[] @default(["header", "metadata", "kpis", "audit"])
  allowedOptionalSections String[] @default(["introduction", "issuesList", "activities", "evidences", "observations", "recommendations", "finalComments"])
  createdById             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, version])
  @@index([organizationId])
  @@map("institutional_templates")
}

model PropertyReportConfig {
  id                    String   @id @default(uuid())
  organizationId        String
  propertyId            String   @unique
  logoUrl               String?
  customSubtitle        String?
  contactInfo           String?
  address               String?
  optionalSectionsOrder String[] @default([])
  version               Int      @default(1)
  isPublished           Boolean  @default(true)
  updatedById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  updatedBy    User         @relation("PropertyConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@map("property_report_configs")
}

model ReportVersion {
  id            String       @id @default(uuid())
  reportId      String
  versionNumber Int
  status        ReportStatus
  title         String
  snapshotData  Json
  pdfStorageKey String?
  pdfSha256     String?
  approvedById  String?
  approvedAt    DateTime?
  approvalNotes String?
  createdById   String
  createdAt     DateTime     @default(now())

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("ReportVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?  @relation("ReportVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([reportId, versionNumber])
  @@index([reportId])
  @@map("report_versions")
}

model ReportReview {
  id            String       @id @default(uuid())
  reportId      String
  reportVersion Int
  reviewerId    String
  decision      ReportStatus
  notes         String
  createdAt     DateTime     @default(now())

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewer User   @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([reviewerId])
  @@map("report_reviews")
}

model ReportDistribution {
  id              String   @id @default(uuid())
  reportId        String
  reportVersion   Int
  recipient       String
  channel         String
  deliveryDate    DateTime
  distributedById String
  notes           String?
  createdAt       DateTime @default(now())

  report        Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  distributedBy User   @relation("ReportDistributedBy", fields: [distributedById], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([distributedById])
  @@map("report_distributions")
}





